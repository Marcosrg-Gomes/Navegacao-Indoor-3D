# Copie para .env e preencha cada valor obrigatório com credenciais próprias.
# ADMIN_API_KEY precisa ter ao menos 32 caracteres.
# A API recusa valores vazios e exemplos inseguros conhecidos.
DATABASE_URL=
ADMIN_API_KEY=
# Opcional: JSON com identificador administrativo e chave individual (mínimo 16 caracteres).
# {} mantém a credencial compartilhada em ADMIN_API_KEY.
ADMIN_API_KEYS={}
SECRET_KEY=
DEBUG=true
# Limite por endereço da conexão direta e por processo; não usa X-Forwarded-For.
DIAGNOSTICS_RATE_LIMIT=60
DIAGNOSTICS_RATE_WINDOW_SECONDS=60
