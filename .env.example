# Exemplo de variaveis de ambiente - Navegacao Indoor 3D
# Copie este arquivo para .env e preencha com valores proprios e seguros.
# NAO insira senhas reais nem segredos do ambiente institucional/SENAI.
# O arquivo .env esta protegido pelo .gitignore e nao deve ser versionado.

DATABASE_URL=mysql+pymysql://navegacao_app:SUA_SENHA_AQUI@127.0.0.1:3306/navegacao_indoor?charset=utf8mb4

ADMIN_API_KEY=sua-chave-admin-com-ao-minimo-32-caracteres
SECRET_KEY=sua-chave-jwt-secreta-e-segura
ADMIN_API_KEYS={}
DEBUG=true

DIAGNOSTICS_RATE_LIMIT=60
DIAGNOSTICS_RATE_WINDOW_SECONDS=60
ROUTES_RATE_LIMIT=30
ROUTES_RATE_WINDOW_SECONDS=60
ROUTE_DISTANCES_RATE_LIMIT=20
ROUTE_DISTANCES_RATE_WINDOW_SECONDS=60

APP_TITLE=API Navegacao Indoor
APP_VERSION=1.0.0
